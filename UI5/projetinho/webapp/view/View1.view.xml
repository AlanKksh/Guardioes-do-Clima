<mvc:View
    controllerName="alan.projetos.projetinho.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:vbm="sap.ui.vbm"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    displayBlock="true">
    
    <Page id="mainPage"
          showNavButton="false"
          class="sapUiResponsiveContentPadding no-page-title">
        <customHeader>
            <OverflowToolbar id="headerToolbar">
                <ToolbarSpacer id="toolbarSpacerLeft"/>

                <Label 
                    id="titleLugares"
                    text="Lugares Populares:" 
                    design="Bold">
                    
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataTitle" priority="High"/>
                    </layoutData>
                </Label>

                <Button 
                    id="btnSaoPaulo"
                    text="São Paulo 14°" 
                    type="Transparent" 
                    icon="sap-icon://building"
                    press="onNavigateToSaoPaulo">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataSaoPaulo" priority="Low"/>
                    </layoutData>
                </Button>

                <Button 
                    id="btnRioGrandeDoSul"
                    text="Rio Grande Do Sul 18°" 
                    type="Transparent" 
                    icon="sap-icon://building"
                    press="onNavigateToRioGrandeDoSul">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataRioGrandeDoSul" priority="Low"/>
                    </layoutData>
                </Button>

                <Button 
                    id="btnRio"
                    text="Rio de Janeiro 21°" 
                    type="Transparent" 
                    icon="sap-icon://building"
                    press="onNavigateToRio">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataRio" priority="Low"/>
                    </layoutData>
                </Button>

                <Button 
                    id="btnBrasilia"
                    text="Brasília 15°" 
                    type="Transparent" 
                    icon="sap-icon://building"
                    press="onNavigateToBrasilia">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataBrasilia" priority="Low"/>
                    </layoutData>
                </Button>

                <Button 
                    id="btnSalvador"
                    text="Salvador 25°" 
                    type="Transparent" 
                    icon="sap-icon://building"
                    press="onNavigateToSalvador">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataSalvador" priority="Low"/>
                    </layoutData>
                </Button>

                <ToolbarSeparator id="toolbarSeparator">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataSeparator" priority="Low"/>
                    </layoutData>
                </ToolbarSeparator>

                <Input 
                    id="cityInput" 
                    width="9rem" 
                    placeholder="Digite uma cidade..." 
                    submit="onButtonPress">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataInput" priority="NeverOverflow"/>
                    </layoutData>
                </Input>

                <Button 
                    id="btnBuscar" 
                    icon="sap-icon://search" 
                    text="Buscar" 
                    type="Ghost" 
                    press="onButtonPress">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataBtnBuscar" priority="NeverOverflow"/>
                    </layoutData>
                </Button>
            </OverflowToolbar>
        </customHeader>
    
        <layout:Grid 
            id="climateGrid"
            defaultSpan="L12 M12 S12" 
            containerQuery="true"
            hSpacing="1"
            vSpacing="1">
            
            <Panel id="climatePanel" class="limiterPanel " height="24rem">
                <layoutData>
                    <layout:GridData span="L5 M12 S12"/>
                </layoutData>
                <content>
                    <VBox id="climateVBox" class="sapUiMediumMargin sapUiSmallMarginTopS">
                        <HBox justifyContent="SpaceBetween" alignItems="Start">
                            <Title id="climateTitle" text="Clima Atual" titleStyle="H4" />
                            <Button text="Ver Mais" type="Emphasized" class="sapUiSizeCompact"/>
                        </HBox>
                            <Text id="currentTimeText" text="{/currentTime}" />
                            
                        <HBox alignItems="Center" class="sapUiMediumMarginTop sapUiMediumMarginBottom">
                            <core:Icon
                                src="{weatherModel>/weatherIcon}"
                                size="4rem"
                                color="{weatherModel>/weatherColor}"
                                class="sapUiMediumMarginEnd">
                            </core:Icon>

                                <Title text="{weatherModel>/main/temp}°C" titleStyle="H1" class="sapUiTinyMarginBottom"/>
                            <VBox class="sapUiSmallMarginBegin weatherConditionBox">
                                <Title text="{weatherModel>/weatherDescriptionPT}" titleStyle="H4" class="sapUiTinyMarginBottom weatherConditionTitle"/>
                                <Text text="Sensação térmica {weatherModel>/main/feels_like}°" class="sapUiSmallText weatherConditionText"/>
                            </VBox>
                        </HBox>
                            <Text text="{weatherModel>/weatherSummary}" class="sapUiSmallMarginTop sapUiMediumMarginBottom weatherSummaryText"/>

                        <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
                            <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <Text text="Qualidade do ar" class=" sapUiTinyMarginEnd"/>
                                <ObjectStatus text="{weatherModel>/main/pressure}" state="Warning" icon="sap-icon://circle" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <Text text="Vento" class=" sapUiTinyMarginEnd" />
                                <ObjectStatus text="{weatherModel>/wind/speed} km/h" state="None" icon="sap-icon://arrow-left" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <Text text="Umidade" class=" sapUiTinyMarginEnd"/>
                                <ObjectStatus text="{weatherModel>/main/humidity}%" state="None" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <Text text="Visibilidade" class=" sapUiTinyMarginEnd"/>
                                <ObjectStatus text="{weatherModel>/visibility} km" state="None" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <Text text="Pressão" class=" sapUiTinyMarginEnd"/>
                                <ObjectStatus text="{weatherModel>/main/pressure} mb" state="None" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <Text text="Ponto de orvalho" class=" sapUiTinyMarginEnd"/>
                                <ObjectStatus text="{weatherModel>/dewPoint}°" state="None" class="sapUiTinyMarginTop"/>
                            </VBox>
                        </HBox>
                    </VBox>            
                </content>
            </Panel>
            
            <VBox id="mapVBox">
                <layoutData>
                    <layout:GridData id="mapGridData" span="L4 M12 S12"/>
                </layoutData>
                <vbm:GeoMap 
                    id="geoMap"
                    width="100%"
                    height="24rem"
                    centerPosition="{viewModel>/long};{viewModel>/lat};0"
                    zoomlevel="10">
                    <vbm:Spots id="mapSpots">
                        <vbm:Spot
                            id="locationSpot"
                            position="{viewModel>/long};{viewModel>/lat};0"/>
                    </vbm:Spots>
                </vbm:GeoMap>
            </VBox>
            
            <Panel id="suggestionsPanel" height="24rem">
                <layoutData>
                    <layout:GridData id="suggestionsGridData" span="L3 M12 S12"/>
                </layoutData>

                <Title text="Sugestões do Dia" titleStyle="H4" class="sapUiMediumMargin"/>
                <content>
                    <VBox id="suggestionsVBox" class="sapUiMediumMarginBegin sapUiMediumMarginEnd">
                        <Text 
                            id="suggestionsDescription" 
                            text="Baseado nas condições climáticas atuais:" 
                            class="sapUiSmallMarginBottom"/>
                        <List
                            id="suggestionsList"
                            items="{suggestionsModel>/suggestions}"
                            noDataText="Busque uma cidade para ver as sugestões">
                            <StandardListItem
                                id="suggestionItem"
                                title="{suggestionsModel>text}"
                                type="Inactive"/>
                        </List>
                    </VBox>
                </content>
            </Panel>
        </layout:Grid>

        <layout:Grid
            id="suggestionsGrid"
            defaultSpan="L12 M12 S12" 
            containerQuery="true"
            hSpacing="1"
            vSpacing="1">

            <Panel id="PanelDayNow" height="8rem" width="100%">
            <layoutData>
                <layout:GridData span="L2 M3 S6"/>
            </layoutData>
            <content>
                <VBox class="sapUiSmallMargin">
                    <Title text="Hoje" titleStyle="H6" class="sapUiTinyMarginBottom"/>
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="todayPanelContent">
                        <HBox alignItems="Center" class="todayPanelIconTemp">
                            <core:Icon
                                src="{weatherModel>/weatherIcon}"
                                size="2rem"
                                color="{weatherModel>/weatherColor}"
                                class="sapUiTinyMarginEnd">
                            </core:Icon>
                            <Title text="{weatherModel>/main/temp}°" titleStyle="H4"/>
                        </HBox>
                          <Text text="{weatherModel>/dynamicText}" class="sapUiSmallText hide-on-small-medium"/>
                    </HBox>
                   
                </VBox>
            </content>
            </Panel>

            <Panel id="PanelDay1" height="8rem" width="100%">
            <layoutData>
                <layout:GridData span="L1 M3 S6"/>
            </layoutData>
            <content>
                <VBox class="sapUiSmallMargin">
                    <Title text="Seg." titleStyle="H6" class="sapUiTinyMarginBottom"/>
                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <HBox alignItems="Center" class="forecastPanelIconTemp">
                            <core:Icon
                                src="{= ${forecastModel>/0/icon} || 'sap-icon://light-mode'}"
                                size="2rem"
                                color="{= ${forecastModel>/0/weatherColor} || '#FFA500'}"
                                class="sapUiTinyMarginEnd">
                            </core:Icon>
                           
                        <VBox alignItems="End">
                            <Title text="{= ${forecastModel>/0/temperature} || '26'}°" titleStyle="H4" class="forecastPanelTemp"/>
                        </VBox>
                        </HBox> 
                    </HBox>
                </VBox>
            </content>
            </Panel>

            <Panel id="PanelDay2" height="8rem" width="100%">
            <layoutData>
                <layout:GridData span="L1 M3 S6"/>
            </layoutData>
            <content>
                <VBox class="sapUiSmallMargin">
                    <Title text="Ter." titleStyle="H6" class="sapUiTinyMarginBottom"/>
                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <core:Icon
                            src="{= ${forecastModel>/1/icon} || 'sap-icon://light-mode'}"
                            size="2rem"
                            color="{= ${forecastModel>/1/weatherColor} || '#FFA500'}"
                            class="sapUiTinyMarginEnd">
                        </core:Icon>
                        <VBox alignItems="End">
                            <Title text="{= ${forecastModel>/1/temperature} || '26'}°" titleStyle="H4" />
                        </VBox>
                    </HBox>
                </VBox>
            </content>
            </Panel>

            <Panel id="PanelDay3" height="8rem" width="100%">
            <layoutData>
                <layout:GridData span="L1 M3 S6"/>
            </layoutData>
            <content>
                <VBox class="sapUiSmallMargin">
                    <Title text="Qua." titleStyle="H6" class="sapUiTinyMarginBottom"/>
                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <core:Icon
                            src="{= ${forecastModel>/2/icon} || 'sap-icon://light-mode'}"
                            size="2rem"
                            color="{= ${forecastModel>/2/weatherColor} || '#FFA500'}"
                            class="sapUiTinyMarginEnd">
                        </core:Icon>
                        <VBox alignItems="End">
                            <Title text="{= ${forecastModel>/2/temperature} || '27'}°" titleStyle="H4"/>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
            </Panel>

            <Panel id="PanelDay4" height="8rem" width="100%">
            <layoutData>
                <layout:GridData span="L1 M3 S6"/>
            </layoutData>
            <content>
                <VBox class="sapUiSmallMargin">
                    <Title text="Qui." titleStyle="H6" class="sapUiTinyMarginBottom"/>
                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <core:Icon
                            src="{= ${forecastModel>/3/icon} || 'sap-icon://light-mode'}"
                            size="2rem"
                            color="{= ${forecastModel>/3/weatherColor} || '#FFA500'}"
                            class="sapUiTinyMarginEnd">
                        </core:Icon>
                        <VBox alignItems="End">
                            <Title text="{= ${forecastModel>/3/temperature} || '24'}°" titleStyle="H4" />
                        </VBox>
                    </HBox>
                </VBox>
            </content>
            </Panel>

            <Panel id="PanelDay5" height="8rem" width="100%">
            <layoutData>
                <layout:GridData span="L1 M3 S6"/>
            </layoutData>
            <content>
                <VBox class="sapUiSmallMargin">
                    <Title text="Sex." titleStyle="H6" class="sapUiTinyMarginBottom"/>
                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <core:Icon
                            src="{= ${forecastModel>/4/icon} || 'sap-icon://cloud'}"
                            size="2rem"
                            color="{= ${forecastModel>/4/weatherColor} || '#0070F3'}"
                            class="sapUiTinyMarginEnd">
                        </core:Icon>
                        <VBox alignItems="End">
                            <Title text="{= ${forecastModel>/4/temperature} || '18'}°" titleStyle="H4" />
                        </VBox>
                    </HBox>
                </VBox>
            </content>
            </Panel>

            <Panel id="PanelDay6" height="8rem" width="100%">
            <layoutData>
                <layout:GridData span="L1 M3 S6"/>
            </layoutData>
            <content>
                <VBox class="sapUiSmallMargin">
                    <Title text="Sáb." titleStyle="H6" class="sapUiTinyMarginBottom"/>
                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <core:Icon
                            src="{= ${forecastModel>/5/icon} || 'sap-icon://cloud'}"
                            size="2rem"
                            color="{= ${forecastModel>/5/weatherColor} || '#0070F3'}"
                            class="sapUiTinyMarginEnd">
                        </core:Icon>
                        <VBox alignItems="End">
                            <Title text="{= ${forecastModel>/5/temperature} || '17'}°" titleStyle="H4" />
                        </VBox>
                    </HBox>
                </VBox>
            </content>
            </Panel>

            <Panel id="PanelDay7" height="8rem" width="100%">
            <layoutData>
                <layout:GridData span="L1 M3 S6"/>
            </layoutData>
            <content>
                <VBox class="sapUiSmallMargin">
                    <Title text="Dom." titleStyle="H6" class="sapUiTinyMarginBottom"/>
                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <core:Icon
                            src="{= ${forecastModel>/6/icon} || 'sap-icon://light-mode'}"
                            size="2rem"
                            color="{= ${forecastModel>/6/weatherColor} || '#FFA500'}"
                            class="sapUiTinyMarginEnd">
                        </core:Icon>
                        <VBox alignItems="End">
                            <Title text="{= ${forecastModel>/6/temperature} || '20'}°" titleStyle="H4" />
                        </VBox>
                    </HBox>
                </VBox>
            </content>
            </Panel>

            <Panel id="weeklyDetailsPanel" height="8rem" width="100%">
                <layoutData>
                    <layout:GridData id="weeklyDetailsGridData" span="L3 M12 S12"/>
                </layoutData>
                <content>
                    <VBox id="weeklyDetailsVBox" class="sapUiSmallMargin">
                        <Title id="weeklyDetailsTitle" text="Sensações do Dia" titleStyle="H6" class="sapUiTinyMarginBottom"/>
                        <HBox id="weeklyDetailsContent" justifyContent="SpaceBetween" alignItems="Center">
                            <VBox id="weeklyHumidityBox" class="sapUiTinyMarginEnd">
                                <Text id="weeklyHumidityLabel" text="Umidade / Secura" class="sapUiTinyMarginBottom"/>
                                <Title id="weeklyHumidityValue" text="{= ${weatherModel>/humidityStatus} || '--'}" titleStyle="H5"/>
                            </VBox>
                            <VBox id="weeklyHeatBox" class="sapUiTinyMarginEnd">
                                <Text id="weeklyHeatLabel" text="Intensidade do Calor" class="sapUiTinyMarginBottom"/>
                                <Title id="weeklyHeatValue" text="{= ${weatherModel>/heatStatus} || '--'}" titleStyle="H5"/>
                            </VBox>
                            <VBox id="weeklyWindBox">
                                <Text id="weeklyWindLabel" text="Influência do Vento" class="sapUiTinyMarginBottom"/>
                                <Title id="weeklyWindValue" text="{= ${weatherModel>/windStatus} || '--'}" titleStyle="H5"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </content>
            </Panel>

            <Panel id="hourlyChartPanel" width="100%">
                <layoutData>
                    <layout:GridData id="gridDataHourlyChart" span="L9 M12 S12"/>
                </layoutData>
                <content>
                    <viz:VizFrame
                        id="hourlyLineChart"
                        width="100%"
                        height="16rem"
                        uiConfig="{applicationSet:'fiori'}"
                        vizType="line"
                        vizProperties="{&quot;title&quot;:{&quot;visible&quot;:false},&quot;valueAxis&quot;:{&quot;title&quot;:{&quot;text&quot;:&quot;Temperatura (°C)&quot;},&quot;scale&quot;:{&quot;fixedRange&quot;:true,&quot;minValue&quot;:0,&quot;maxValue&quot;:40,&quot;stepSize&quot;:10},&quot;axisTick&quot;:{&quot;visible&quot;:true},&quot;label&quot;:{&quot;formatString&quot;:&quot;u&quot;}}}">
                        <viz:dataset>
                            <viz.data:FlattenedDataset
                                id="hourlyDataset"
                                data="{hourlyChartModel>/points}">
                                <viz.data:dimensions>
                                    <viz.data:DimensionDefinition
                                        id="hourDimension"
                                        name="Hora"
                                        value="{hourLabel}"/>
                                </viz.data:dimensions>
                                <viz.data:measures>
                                    <viz.data:MeasureDefinition
                                        id="hourTemperatureMeasure"
                                        name="Temperatura"
                                        value="{temperature}"/>
                                </viz.data:measures>
                            </viz.data:FlattenedDataset>
                        </viz:dataset>
                        <viz:feeds>
                            <viz.feeds:FeedItem
                                id="valueAxisFeed"
                                uid="valueAxis"
                                type="Measure"
                                values="Temperatura"/>
                            <viz.feeds:FeedItem
                                id="categoryAxisFeed"
                                uid="categoryAxis"
                                type="Dimension"
                                values="Hora"/>
                        </viz:feeds>
                    </viz:VizFrame>
                </content>
            </Panel>

            <VBox id="imageWeatherVBox" width="100%">
                <layoutData>
                    <layout:GridData span="L3 M12 S12"/>
                </layoutData>
                <Image 
                    id="weatherImage"
                    src="../assets/logo-marca.jpeg"
                    alt="Clima atual"
                    width="100%"
                    height="17.310rem"
                    densityAware="false"
                    class=""/>
            </VBox>

            

            
        </layout:Grid>
        




        







    
    </Page>

</mvc:View>
