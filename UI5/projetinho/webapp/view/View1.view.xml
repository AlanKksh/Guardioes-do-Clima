<mvc:View
    controllerName="alan.projetos.projetinho.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:vbm="sap.ui.vbm"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    displayBlock="true">
    
    <Page id="mainPage" title="UI5 Clima" 
          showNavButton="false" 
          class="sapUiResponsiveContentPadding">
        <customHeader>
            <OverflowToolbar id="headerToolbar">
                <Title  
                    id="pageTitleMain"
                    text="UI5 Clima"
                    level="H3">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataPageTitle" priority="NeverOverflow"/>
                    </layoutData>
                </Title>

                <ToolbarSpacer id="toolbarSpacerLeft"/>

                <Label 
                    id="titleLugares"
                    text="Lugares Populares:" 
                    design="Bold">
                    
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataTitle" priority="High"/>
                    </layoutData>
                </Label>

                <Button 
                    id="btnSaoPaulo"
                    text="São Paulo 14°" 
                    type="Transparent" 
                    icon="sap-icon://building"
                    press="onNavigateToSaoPaulo">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataSaoPaulo" priority="Low"/>
                    </layoutData>
                </Button>

                <Button 
                    id="btnRioGrandeDoSul"
                    text="Rio Grande Do Sul 18°" 
                    type="Transparent" 
                    icon="sap-icon://building"
                    press="onNavigateToRioGrandeDoSul">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataRioGrandeDoSul" priority="Low"/>
                    </layoutData>
                </Button>

                <Button 
                    id="btnRio"
                    text="Rio de Janeiro 21°" 
                    type="Transparent" 
                    icon="sap-icon://building"
                    press="onNavigateToRio">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataRio" priority="Low"/>
                    </layoutData>
                </Button>

                <Button 
                    id="btnBrasilia"
                    text="Brasília 15°" 
                    type="Transparent" 
                    icon="sap-icon://building"
                    press="onNavigateToBrasilia">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataBrasilia" priority="Low"/>
                    </layoutData>
                </Button>

                <Button 
                    id="btnSalvador"
                    text="Salvador 25°" 
                    type="Transparent" 
                    icon="sap-icon://building"
                    press="onNavigateToSalvador">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataSalvador" priority="Low"/>
                    </layoutData>
                </Button>

                <ToolbarSeparator id="toolbarSeparator">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataSeparator" priority="Low"/>
                    </layoutData>
                </ToolbarSeparator>

                <Input 
                    id="cityInput" 
                    width="9rem" 
                    placeholder="Digite uma cidade..." 
                    submit="onButtonPress">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataInput" priority="NeverOverflow"/>
                    </layoutData>
                </Input>

                <Button 
                    id="btnBuscar" 
                    icon="sap-icon://search" 
                    text="Buscar" 
                    type="Ghost" 
                    press="onButtonPress">
                    <layoutData>
                        <OverflowToolbarLayoutData id="layoutDataBtnBuscar" priority="NeverOverflow"/>
                    </layoutData>
                </Button>
            </OverflowToolbar>
        </customHeader>
    
        <layout:Grid 
            id="climateGrid"
            defaultSpan="L12 M12 S12" 
            containerQuery="true"
            hSpacing="1"
            vSpacing="1">
            
            <Panel id="climatePanel" class="limiterPanel">
                <layoutData>
                    <layout:GridData span="L5 M12 S12"/>
                </layoutData>
                <content>
                    <VBox id="climateVBox" class="sapUiMediumMargin">
                        <HBox justifyContent="SpaceBetween" alignItems="Start">
                            <Title id="climateTitle" text="Clima Atual" titleStyle="H4" />
                            <Button text="Ver Mais" type="Emphasized" class="sapUiSizeCompact"/>
                        </HBox>
                            <Text id="currentTimeText" text="{/currentTime}" />
                            
                        <HBox alignItems="Center" class="sapUiMediumMarginTop sapUiMediumMarginBottom">
                            <core:Icon
                                src="sap-icon://light-mode"
                                size="4rem"
                                color="#FFA500"
                                class="sapUiMediumMarginEnd">
                            </core:Icon>

                                <Title text="14°C" titleStyle="H1" class="sapUiTinyMarginBottom"/>
                            <VBox class="sapUiSmallMarginBegin">
                                <Title text="Ensolarado" titleStyle="H4" class="sapUiTinyMarginBottom"/>
                                <Text text="Sensação térmica 14°" class="sapUiSmallText"/>
                            </VBox>
                        </HBox>
                            <Text text="O céu estará predominante ensolarado, a máxima sera de 25°C." class="sapUiSmallMarginTop sapUiMediumMarginBottom"/>

                        <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
                            <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <Text text="Qualidade do ar" class=" sapUiTinyMarginEnd"/>
                                <ObjectStatus text="116" state="Warning" icon="sap-icon://circle" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <Text text="Vento" class=" sapUiTinyMarginEnd" />
                                <ObjectStatus text="8 km/h" state="None" icon="sap-icon://arrow-left" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <Text text="Umidade" class=" sapUiTinyMarginEnd"/>
                                <ObjectStatus text="90%" state="None" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <Text text="Visibilidade" class=" sapUiTinyMarginEnd"/>
                                <ObjectStatus text="8 km" state="None" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <Text text="Pressão" class=" sapUiTinyMarginEnd"/>
                                <ObjectStatus text="1022 mb" state="None" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <Text text="Ponto de orvalho" class=" sapUiTinyMarginEnd"/>
                                <ObjectStatus text="13°" state="None" class="sapUiTinyMarginTop"/>
                            </VBox>
                        </HBox>
                    </VBox>            
                </content>
            </Panel>
            
            <VBox id="mapVBox">
                <layoutData>
                    <layout:GridData span="L4 M12 S12"/>
                </layoutData>
                <vbm:GeoMap 
                    id="geoMap"
                    width="100%"
                    height="24rem"
                    centerPosition="{viewModel>/long};{viewModel>/lat};0"
                    zoomlevel="10">
                    <vbm:Spots id="mapSpots">
                        <vbm:Spot
                            id="locationSpot"
                            position="{viewModel>/long};{viewModel>/lat};0"/>
                    </vbm:Spots>
                </vbm:GeoMap>
            </VBox>
            
            <Panel id="recommendationPanel" height="24rem">
                <layoutData>
                    <layout:GridData span="L3 M12 S12"/>
                </layoutData>
                <content>
                    <VBox class="sapUiSmallMargin">
                       <Image width="100%" height="100%"/>
                        
                        <layout:Grid defaultSpan="L12 M12 S12">
                           
                        </layout:Grid>
                    </VBox>
                </content>
            </Panel>
            
        </layout:Grid>

        




        







    
    </Page>

</mvc:View>